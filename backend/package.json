{
  "name": "grocery-store-backend",
  "version": "1.0.0",
  "description": "MERN grocery e-commerce backend with eSewa payment integration",
  "main": "server.js",
  "type": "module",
  "engines": {
    "node": ">=18.0.0"
  },
  "scripts": {
    "start": "node server.js",
    "dev": "nodemon server.js",
    "seed": "node utils/seeder.js",
    "seed:import": "node utils/seeder.js",
    "seed:catalog": "node utils/seeder.js --products-only",
    "admin:create": "node utils/createAdmin.js",
    "seed:destroy": "node utils/seeder.js -d"
  },
  "keywords": [
    "mern",
    "grocery",
    "ecommerce",
    "esewa",
    "mongodb",
    "express",
    "react",
    "tailwindcss"
  ],
  "author": "Your Name",
  "license": "MIT",
  "dependencies": {
    "bcryptjs": "^3.0.3",
    "cookie-parser": "^1.4.7",
    "cors": "^2.8.6",
    "dotenv": "^18.0.7",
    "express": "^5.3.0",
    "express-async-handler": "^1.2.0",
    "jsonwebtoken": "^9.0.3",
    "mongoose": "^9.11.1",
    "neppayments": "^2.0.6"
  },
  "devDependencies": {
    "nodemon": "^3.1.7"
  }
}
